# AI-2 /etc/default/grub (based on Artix's artools common one). Calamares'
# grubcfg keeps an existing file's values, so this is what installed systems
# get. AI-2 changes: the menu remembers the last choice (a dual-boot user who
# mostly wants Windows should not have to catch it every time), 8 s instead
# of 3 (old machines take a while to draw the themed menu), distributor AI-2,
# no "splash" on the kernel line while there is no Plymouth.
GRUB_DEFAULT="saved"
GRUB_SAVEDEFAULT="true"
GRUB_TIMEOUT="8"
GRUB_DISTRIBUTOR="AI-2"
GRUB_CMDLINE_LINUX_DEFAULT="quiet"
GRUB_CMDLINE_LINUX="net.ifnames=0"

# Preload both GPT and MBR modules so that they are not missed
GRUB_PRELOAD_MODULES="part_gpt part_msdos"

GRUB_TERMINAL_INPUT="console"
GRUB_GFXMODE="1024x768,800x600"
GRUB_GFXPAYLOAD_LINUX="keep"

GRUB_DISABLE_RECOVERY="true"
GRUB_DISABLE_LINUX_RECOVERY="true"

export GRUB_COLOR_NORMAL="light-blue/black"
export GRUB_COLOR_HIGHLIGHT="light-cyan/blue"

# The AI-2 theme ships in the artix theme directory on purpose (see branding/grub-theme/).
GRUB_THEME="/usr/share/grub/themes/artix/theme.txt"

# Probe for other installed operating systems (Windows shows in the menu)
GRUB_DISABLE_OS_PROBER="false"
