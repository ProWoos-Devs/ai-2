#!/bin/sh
# AI-2: start the installer straight away with the OFFLINE Calamares
# configuration. No "select installer configuration" chooser (Rafael,
# 2026-08-16: online is experimental, always go with offline). Same two steps
# Artix's calamares-config-switcher does after its dialog; the live polkit
# rules make both pkexec calls silent.
pkexec ln -snf /etc/calamares-offline /etc/calamares
# The live boot activates any swap partition it finds on the internal disk;
# Calamares then refuses to offer "Erase disk" for that disk (in-use
# partition). Found 2026-08-25 on a machine whose previous Linux left a swap
# partition. Release all swap before installing; the live session does not
# rely on it.
pkexec swapoff --all
exec pkexec calamares "$@"
