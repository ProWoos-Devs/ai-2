#!/bin/sh
# AI-2: modified copy of Artix's desktop-items (artix-live-base, GPL). Adds
# the START-HERE.txt guide to the live desktop and drops the one-line
# README.txt (its content is in START-HERE).

BINDIR=${BINDIR:-/usr/bin}
DATADIR=${DATADIR:-/usr/share}

# Ensure the user directories are created, some DEs (MATE)
# create them after autostart scripts are run
xdg-user-dirs-update --force

xdg=$(xdg-user-dir DESKTOP)
src="${DATADIR}"/applications

# if [ -f $src/org.kde.konversation.desktop ]; then
#     install -m644 $src/org.kde.konversation.desktop \
#     $xdg/org.kde.konversation.desktop
# fi

# if [ -f "${BINDIR}"/calamares ]; then
#     installer='calamares.desktop'
#     cp $src/$installer "$xdg/$installer"
# fi


# AI-2: the Artix PDF guides are not copied (no PDF viewer in the lean
# live image; START-HERE points at wiki.artixlinux.org instead).

# AI-2: xfdesktop shows these icons in REVERSE order of creation, so the
# installer launcher and then the START-HERE guide are copied LAST: the
# desktop reads Home, File System, START-HERE, Install AI-2.
# Use cp instead of symlinks because ugly arrows or no proper icons
if [ -f "${BINDIR}"/ai2-install ]; then
    launcher='calamares-config-switcher.desktop'
    cp "$src/$launcher" "$xdg/$launcher"
    # Cinnamon needs this
    chmod +x "$xdg/$launcher"
fi

# AI-2 guide for beginners (installed system keeps it in /usr/share/doc/ai2)
cp /usr/share/doc/ai2/START-HERE.txt "$xdg"/START-HERE.txt

# AI-2: mousepad (the only text editor) reads GSettings; wrap long lines and
# open big enough to read START-HERE without sideways scrolling.
gsettings set org.xfce.mousepad.preferences.view word-wrap true 2>/dev/null
gsettings set org.xfce.mousepad.state.window width 900 2>/dev/null
gsettings set org.xfce.mousepad.state.window height 650 2>/dev/null
