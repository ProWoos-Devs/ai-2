<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
  "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">

<!-- Everything AI-2 adds to the desktop sits in one submenu, Applications >
     AI-2, so the guides can name a single place. Every AI-2 entry carries the
     X-AI2 category and nothing else, which is what keeps it out of
     Accessories and Office (where the earlier Utility;Office categories had
     scattered them). The file is merged into XFCE's menu from
     /etc/xdg/menus/applications-merged/, the directory garcon 4.20 actually
     reads for xfce-applications.menu (verified with garcon itself: under
     xfce-applications-merged/ the entries fall into "Other"). -->
<Menu>
    <Name>Xfce</Name>
    <!-- The AI-2 submenu first, above Run Program, then a separator. A merged
         Layout replaces the one in xfce-applications.menu, so everything after
         the first separator is a copy of garcon 4.20's own top-level layout
         (tests/test_menu.py compares it with the installed file when there
         is one, so a garcon update that changes it shows up). -->
    <Layout>
        <Menuname>AI-2</Menuname>
        <Separator/>
        <Filename>xfce4-run.desktop</Filename>
        <Separator/>
        <Filename>xfce4-terminal-emulator.desktop</Filename>
        <Filename>xfce4-file-manager.desktop</Filename>
        <Filename>xfce4-mail-reader.desktop</Filename>
        <Filename>xfce4-web-browser.desktop</Filename>
        <Separator/>
        <Menuname>Settings</Menuname>
        <Separator/>
        <Merge type="all"/>
        <Separator/>
        <Filename>xfce4-about.desktop</Filename>
        <Filename>xfce4-session-logout.desktop</Filename>
    </Layout>
    <Menu>
        <Name>AI-2</Name>
        <Directory>ai2.directory</Directory>
        <Include>
            <Category>X-AI2</Category>
        </Include>
        <!-- About AI-2 first (Rafael, 2026-09-15), then every other entry in
             garcon's own name order. Explicit, because name order alone
             would put the German "Über AI-2" last. -->
        <Layout>
            <Filename>ai2-about.desktop</Filename>
            <Merge type="all"/>
        </Layout>
    </Menu>
</Menu>
