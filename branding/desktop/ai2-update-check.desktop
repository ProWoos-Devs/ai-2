[Desktop Entry]
Type=Application
Version=1.0
Name=AI-2 update check
Comment=Tell the user when system updates are waiting, at login and then daily for the life of the session (no automatic installs)
Exec=sh -c "sleep 180; exec ai-2 update-check --notify --max-age 20 --every 6"
Icon=ai2
Terminal=false
NoDisplay=true
OnlyShowIn=XFCE;
X-GNOME-Autostart-Phase=Applications
