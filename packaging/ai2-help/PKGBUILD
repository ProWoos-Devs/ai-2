# Do not edit by hand: the file this installs is the one the catalog
# publishes, same URL and same SHA-256, so a pack that comes with AI-2 is
# byte-for-byte the pack `ai-2 knowledge install ai2-help` would fetch.

pkgname=ai2-help
pkgver=2026.09.18
pkgrel=2
pkgdesc="AI-2 Help Knowledge Pack for AI-2 (107 parts, en)"
arch=('any')
url="https://github.com/ProWoos-Devs/ai2-knowledge"
license=('MIT')
depends=('ai-2')
source=("ai2-help-$pkgver.ai2pack::https://github.com/ProWoos-Devs/ai2-knowledge/releases/download/packs-2026-09-18/ai2-help.ai2pack")
sha256sums=('b32036ce6b41587afe54fa24402d11fb9c3c30491c77a29c5de98b571fca71df')
noextract=("ai2-help-$pkgver.ai2pack")

package() {
  local dest="$pkgdir/usr/share/ai2/doc/ai2-help"
  install -dm755 "$dest"
  # a pack is a zip of manifest.yml + index.sqlite
  bsdtar -xf "$srcdir/ai2-help-$pkgver.ai2pack" -C "$dest" manifest.yml index.sqlite
  chmod 644 "$dest/manifest.yml" "$dest/index.sqlite"
  # the record `ai-2 knowledge list` reads to say where a pack came from
  printf '%s\n' "from: AI-2 itself" "id: ai2-help" "version: 2026-09-18" \
      "sha256: b32036ce6b41587afe54fa24402d11fb9c3c30491c77a29c5de98b571fca71df" > "$dest/origin.yml"
  chmod 644 "$dest/origin.yml"
}
