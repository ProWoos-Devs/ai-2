# Generated by tools/render-pack-packages.py from ai2/data/packs.yml.
# Do not edit by hand: the file this installs is the one the catalog
# publishes, same URL and same SHA-256, so a pack that comes with AI-2 is
# byte-for-byte the pack `ai-2 knowledge install linux-essentials` would fetch.

pkgname=ai2-linux-essentials
pkgver=2026.09.18
pkgrel=2
pkgdesc="Linux Essentials Knowledge Pack for AI-2 (40 parts, en)"
arch=('any')
url="https://github.com/ProWoos-Devs/ai2-knowledge"
license=('MIT')
depends=('ai-2')
source=("ai2-linux-essentials-$pkgver.ai2pack::https://github.com/ProWoos-Devs/ai2-knowledge/releases/download/packs-2026-09-18/linux-essentials.ai2pack")
sha256sums=('dd0ad1e1957c5fa3eb47aba3829a9078e84478d65f6b7bff2ed5d987defd232e')
noextract=("ai2-linux-essentials-$pkgver.ai2pack")

package() {
  local dest="$pkgdir/usr/share/ai2/doc/linux-essentials"
  install -dm755 "$dest"
  # a pack is a zip of manifest.yml + index.sqlite
  bsdtar -xf "$srcdir/ai2-linux-essentials-$pkgver.ai2pack" -C "$dest" manifest.yml index.sqlite
  chmod 644 "$dest/manifest.yml" "$dest/index.sqlite"
  # the record `ai-2 knowledge list` reads to say where a pack came from
  printf '%s\n' "from: AI-2 itself" "id: linux-essentials" "version: 2026-09-18" \
      "sha256: dd0ad1e1957c5fa3eb47aba3829a9078e84478d65f6b7bff2ed5d987defd232e" > "$dest/origin.yml"
  chmod 644 "$dest/origin.yml"
}
