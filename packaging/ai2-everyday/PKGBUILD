# Generated by tools/render-pack-packages.py from ai2/data/packs.yml.
# Do not edit by hand: the file this installs is the one the catalog
# publishes, same URL and same SHA-256, so a pack that comes with AI-2 is
# byte-for-byte the pack `ai-2 knowledge install everyday` would fetch.

pkgname=ai2-everyday
pkgver=2026.09.18
pkgrel=2
pkgdesc="Everyday Reference Knowledge Pack for AI-2 (196 parts, en)"
arch=('any')
url="https://github.com/ProWoos-Devs/ai2-knowledge"
license=('CC0-1.0')
depends=('ai-2')
source=("ai2-everyday-$pkgver.ai2pack::https://github.com/ProWoos-Devs/ai2-knowledge/releases/download/packs-2026-09-18/everyday.ai2pack")
sha256sums=('27de9338dbc7dca4b7e7de581704d9386d6fa8742a26af839f435bcd15d50337')
noextract=("ai2-everyday-$pkgver.ai2pack")

package() {
  local dest="$pkgdir/usr/share/ai2/doc/everyday"
  install -dm755 "$dest"
  # a pack is a zip of manifest.yml + index.sqlite
  bsdtar -xf "$srcdir/ai2-everyday-$pkgver.ai2pack" -C "$dest" manifest.yml index.sqlite
  chmod 644 "$dest/manifest.yml" "$dest/index.sqlite"
  # the record `ai-2 knowledge list` reads to say where a pack came from
  printf '%s\n' "from: AI-2 itself" "id: everyday" "version: 2026-09-18" \
      "sha256: 27de9338dbc7dca4b7e7de581704d9386d6fa8742a26af839f435bcd15d50337" > "$dest/origin.yml"
  chmod 644 "$dest/origin.yml"
}
