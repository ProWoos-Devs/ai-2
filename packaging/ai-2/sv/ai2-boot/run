#!/bin/sh
# Apply the boot-time settings once, then stay as the processor guard (which
# parks itself, Artix's one-shot convention, where it has nothing to watch).
/usr/lib/ai2/boot-tuning.sh
# the disks' own health records, for `ai-2 doctor` (in the background: a slow
# disk must not hold the boot)
[ -x /usr/lib/ai2/disk-health.sh ] && /usr/lib/ai2/disk-health.sh &
[ -x /usr/lib/ai2/cpu-guard.sh ] && exec /usr/lib/ai2/cpu-guard.sh
exec pause
