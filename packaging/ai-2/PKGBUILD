# Maintainer: Rafael Minuesa <rafael.minuesa@gmail.com>
# The AI-2 configurator tool. Ships the ai2 Python package at /usr/lib/ai2
# (same layout the ISO root-overlay uses, independent of site-packages) with
# the /usr/bin/ai-2 wrapper and the AI-2 alias.
#
# Source tarball is produced from the git tree by ../build-packages.sh
# (git archive of www/ai-2), so a package always maps to a commit.

pkgname=ai-2
pkgver=0.5.2
pkgrel=1
pkgdesc="AI-2 automatically transforms compatible PCs into the best AI workstation that hardware can realistically support"
arch=('any')
url="https://github.com/ProWoos-Devs/AI-2"
license=('MIT')
depends=('python' 'python-yaml' 'xdg-utils' 'hicolor-icon-theme' 'dconf' 'pacman-contrib' 'fakeroot')
checkdepends=('python-pytest')
optdepends=('pciutils: GPU detection via lspci'
            'zramen: compressed swap, installed by ai-2 init --apply on low-RAM tiers'
            'earlyoom: userspace OOM killer, installed by ai-2 init --apply on low-RAM tiers'
            'ai2-llama-cpp-baseline: CPU inference runtime for pre-SSE4.1 CPUs'
            'ai2-llama-cpp-noavx: CPU inference runtime for SSE4.x CPUs without AVX2'
            'ai2-llama-cpp-avx2: CPU inference runtime for AVX2 CPUs'
            'xfce4-terminal: terminal window for the first-login setup wizard'
            'libnotify: desktop notification when system updates are waiting')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
  cd "$pkgname-$pkgver"
  PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 python -m pytest -q tests/
}

package() {
  cd "$pkgname-$pkgver"

  install -d "$pkgdir/usr/lib/ai2"
  cp -a ai2 "$pkgdir/usr/lib/ai2/ai2"
  find "$pkgdir/usr/lib/ai2" -name __pycache__ -type d -exec rm -rf {} +
  python -m compileall -q -d /usr/lib/ai2 "$pkgdir/usr/lib/ai2"

  install -Dm755 packaging/ai-2/ai-2-wrapper.sh "$pkgdir/usr/bin/ai-2"
  ln -s ai-2 "$pkgdir/usr/bin/AI-2"

  # first-login wizard + chat launcher + icon
  install -Dm755 branding/ai2-first-boot "$pkgdir/usr/bin/ai2-first-boot"
  install -Dm644 branding/desktop/ai2-setup.desktop "$pkgdir/etc/xdg/autostart/ai2-setup.desktop"
  install -Dm644 branding/desktop/ai2-chat.desktop "$pkgdir/usr/share/applications/ai2-chat.desktop"
  # passive update notification: daily session check + login-shell hint
  install -Dm644 branding/desktop/ai2-update-check.desktop "$pkgdir/etc/xdg/autostart/ai2-update-check.desktop"
  install -Dm644 packaging/ai-2/ai2-updates.profile.sh "$pkgdir/etc/profile.d/ai2-updates.sh"
  install -Dm644 branding/ai2-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ai2.svg"
  install -Dm644 branding/START-HERE.txt "$pkgdir/usr/share/doc/ai2/START-HERE.txt"
  # mousepad (the only text editor) wraps long lines; pacman compiles schemas
  install -Dm644 branding/90_ai2.gschema.override "$pkgdir/usr/share/glib-2.0/schemas/90_ai2.gschema.override"

  # Our fixed artix-service (Artix's cannot enable runit services inside the
  # Calamares chroot). The ISO overlay places it for the install; /usr/bin is
  # owned by the base package, so a pacman hook re-applies it after upgrades.
  install -Dm755 packaging/ai-2/artix-service "$pkgdir/usr/lib/ai2/artix-service"
  install -Dm644 packaging/ai-2/ai2-artix-service.hook "$pkgdir/usr/share/libalpm/hooks/zz-ai2-artix-service.hook"

  # session bus at $XDG_RUNTIME_DIR/bus (WebKit sandbox needs it; see the script)
  install -Dm755 packaging/ai-2/30-ai2-session-bus.sh "$pkgdir/etc/X11/xinit/xinitrc.d/30-ai2-session-bus.sh"

  # boot-time memory tuning (zswap/MGLRU live in sysfs): script + one-shot services
  install -Dm755 packaging/ai-2/boot-tuning.sh "$pkgdir/usr/lib/ai2/boot-tuning.sh"
  install -Dm755 packaging/ai-2/sv/ai2-boot/run "$pkgdir/etc/runit/sv/ai2-boot/run"
  install -Dm644 packaging/ai-2/systemd/ai2-boot.service "$pkgdir/usr/lib/systemd/system/ai2-boot.service"

  install -Dm644 branding/motd "$pkgdir/usr/share/ai2/motd"
  install -Dm644 branding/lightdm-gtk-greeter.conf "$pkgdir/usr/share/ai2/lightdm-gtk-greeter.conf"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES.md "$pkgdir/usr/share/licenses/$pkgname/LICENSES.md"
}
