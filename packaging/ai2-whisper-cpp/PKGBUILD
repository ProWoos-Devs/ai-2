# Maintainer: Rafael Minuesa <rafael.minuesa@gmail.com>
# whisper.cpp speech-to-text runtime for AI-2: ONE package, the CPU build
# chosen at start, the same scheme as ai2-llama-cpp (see that PKGBUILD for the
# full reasoning and the limits of the gate).
#
# Built once with GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS: whisper-cli,
# whisper-bench, libwhisper and ggml's core are compiled for plain x86-64, and
# the CPU backend comes as one libggml-cpu-<variant>.so per instruction-set
# level. whisper-cli and whisper-bench call ggml_backend_load_all() (v1.9.4,
# examples/cli/cli.cpp and examples/bench/bench.cpp), which dlopens every
# variant found in GGML_BACKEND_DIR or next to the executable, asks each for a
# score (0 when the CPU lacks a feature it was compiled for, x64 always 1) and
# keeps the best. So no per-CPU package family: the first review of this PR
# (2026-09-15) pointed out that three whisper packages would recreate exactly
# the burden ai2-llama-cpp just shed.
#
# Deliberately self-contained (XDA review 2026-09-14, item 5): whisper.cpp
# ships its own ggml (0.23.0 at this tag; the pinned llama.cpp carries 0.19.0,
# the two pins move at different speeds), no ffmpeg (WHISPER_COMMON_FFMPEG=OFF,
# so a world ffmpeg soname bump can never break a signed package; `ai-2
# transcribe` converts the audio with the ffmpeg command instead), no SDL2 (no
# live dictation), no server. Only whisper-cli and whisper-bench are built; in
# whisper's ggml every backend module is a build dependency of ggml
# (add_dependencies(ggml ...)), so those two targets build all the variants.
#
# The gate is the one ai2-llama-cpp uses. isa-check.sh is a copy of
# packaging/ai2-llama-cpp/isa-check.sh (makepkg sources must sit next to the
# PKGBUILD); tests/test_packaging.py keeps the two byte-identical.
#
# Everything installs flat into /usr/lib/ai2/runtimes/whisper.cpp/ ($ORIGIN
# rpath), which is where ai2/speech.py looks. Nothing lands in /usr/bin.

pkgname=ai2-whisper-cpp
_tag=v1.9.4
pkgver=${_tag#v}
pkgrel=1
pkgdesc="whisper.cpp speech-to-text runtime for AI-2 (file transcription, every CPU class, the build for this CPU chosen at start)"
arch=('x86_64')
url="https://github.com/ggml-org/whisper.cpp"
license=('MIT')
makedepends=('cmake' 'git' 'binutils' 'patchelf')
depends=('gcc-libs' 'glibc')
options=('!lto' '!debug')
source=("whisper.cpp::git+https://github.com/ggml-org/whisper.cpp.git#tag=$_tag"
        'isa-check.sh')
sha256sums=('SKIP' 'SKIP')

_rtdir=/usr/lib/ai2/runtimes/whisper.cpp

build() {
  # The contract for everything that is not a CPU variant: plain x86-64 plus
  # popcnt, as in ai2-llama-cpp. ggml adds each variant's -m flags PRIVATE to
  # that variant's target, on top of these.
  local flags='-march=x86-64 -mtune=generic -mpopcnt'
  cmake -S whisper.cpp -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_BACKEND_DIR="$_rtdir" \
    -DGGML_NATIVE=OFF \
    -DGGML_OPENMP=ON \
    -DGGML_BLAS=OFF \
    -DGGML_VULKAN=OFF \
    -DGGML_CUDA=OFF \
    -DWHISPER_USE_SYSTEM_GGML=OFF \
    -DWHISPER_BUILD_TESTS=OFF \
    -DWHISPER_BUILD_EXAMPLES=ON \
    -DWHISPER_BUILD_SERVER=OFF \
    -DWHISPER_SDL2=OFF \
    -DWHISPER_COMMON_FFMPEG=OFF \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_C_FLAGS="$CFLAGS $flags" -DCMAKE_CXX_FLAGS="$CXXFLAGS $flags"
  cmake --build build -j"$(nproc)" --target whisper-cli whisper-bench
}

# The files that ship, all from build/bin: the two programs, the core
# libraries, and every CPU variant module.
_shipped() {
  echo whisper-cli whisper-bench
  ls build/bin/libwhisper.so* build/bin/libggml.so* build/bin/libggml-base.so* 2>/dev/null | xargs -n1 basename
  ls build/bin/libggml-cpu-*.so | xargs -n1 basename
}

check() {
  local f files
  files=$(_shipped | tr ' ' '\n')     # from $srcdir, before the cd
  cd build/bin
  # Gate 1, per file: everything but the CPU variants, plus the x64 variant,
  # clean for the pure-SSE2 machine; the sse42 variant for the no-AVX machine;
  # the AVX-class variants exempt by name (the runtime score guards them).
  for f in $files; do
    case "$f" in
      libggml-cpu-x64.so) bash ../../isa-check.sh baseline "$f" ;;
      libggml-cpu-sse42.so) bash ../../isa-check.sh noavx "$f" ;;
      libggml-cpu-*.so) echo "isa-check skip [avx-class variant, runtime-scored] $f" ;;
      *) bash ../../isa-check.sh baseline "$f" ;;
    esac
  done
  # Gate 2: what a variant runs at dlopen must be clean for the pure-SSE2
  # machine, because the loader opens every variant before it can score it.
  for f in libggml-cpu-*.so; do
    bash ../../isa-check.sh ctors "$f"
  done
  test -f libggml-cpu-x64.so
  test -f libggml-cpu-sse42.so
  test -f libggml-cpu-haswell.so
}

package() {
  local dest="$pkgdir$_rtdir" f files
  files=$(_shipped | tr ' ' '\n')
  install -d "$dest"
  for f in $files; do
    if [ -L "build/bin/$f" ]; then
      cp -a "build/bin/$f" "$dest/"
    else
      install -m755 "build/bin/$f" "$dest/"
    fi
  done
  for f in "$dest"/*; do
    [ -L "$f" ] && continue
    patchelf --set-rpath '$ORIGIN' "$f"
  done
  install -Dm644 whisper.cpp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
