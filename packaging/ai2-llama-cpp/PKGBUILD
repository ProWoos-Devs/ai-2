# Maintainer: Rafael Minuesa <rafael.minuesa@gmail.com>
# llama.cpp CPU runtime for AI-2: ONE package, the CPU build chosen at start.
#
# Until 10398-1 this was three packages (-baseline pure SSE2, -noavx SSE4.2,
# -avx2 Haswell+), each a full build tree, because ggml assumes SSE4.2 and a
# stray pinsrq SIGILLs a 2011 A4-3305M (proven 2026-08-13). Since then the
# same pinned source is built ONCE with GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS,
# the way upstream's releases and Arch's ggml package are built: every
# executable and library is compiled for plain x86-64, and the CPU backend
# comes as one libggml-cpu-<variant>.so per instruction-set level (x64,
# sse42, sandybridge, ivybridge, piledriver, haswell, ... at b10398). At
# start, ggml dlopens every variant, asks each for a score (0 when the CPU
# lacks a feature it was compiled for; x64 always scores 1) and keeps the
# best. So a cloned disk or a CPU swap needs no reinstall, and the ISO ships
# the common libraries once instead of three times.
#
# What the objdump gate (isa-check.sh) still guarantees: everything but the
# AVX-class variants is clean for the pure-SSE2 machine, libggml-cpu-sse42.so
# is clean for the no-AVX machine. What it cannot see: the AVX-class variants
# are exempt by name, so for them the runtime score is the only guard, and
# b10398's score checks CPUID only, never OSXSAVE (llama.cpp issue 28328, a
# KVM guest booted with clearcpuid=xsave picked haswell and SIGILLed; bare
# metal is not exposed). The second gate, isa-check.sh ctors, disassembles
# every constructor a variant runs at dlopen (the PR 11780 class: a static
# __m128i initializer in an AVX variant ran on a non-AVX machine before the
# score could say no) and requires it clean for the pure-SSE2 machine.
#
# Release gates beyond check(), both run by hand on the built package:
#   1. A KVM guest that looks like the oldest target, the test install booted
#      with  -cpu host,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,-fma,-f16c,-bmi1,-bmi2,-avx512f
#      (check /proc/cpuinfo in the guest): llama-bench completes and the
#      load_backend line names libggml-cpu-x64.so.
#   2. The same on RMM-PC (A4-3305M, no SSSE3, no SSE4.1), the real machine.
#
# Everything installs flat into /usr/lib/ai2/runtimes/llama.cpp/ ($ORIGIN
# rpath), which is where ai2/runtime.py looks first. GGML_BACKEND_DIR is that
# directory too, so the loader finds the variants wherever the executable is
# started from. Nothing lands in /usr/bin.

pkgname=ai2-llama-cpp
_tag=b10398
pkgver=${_tag#b}
pkgrel=1
pkgdesc="llama.cpp CPU inference runtime for AI-2 (every CPU class, the build for this CPU chosen at start)"
arch=('x86_64')
url="https://github.com/ggml-org/llama.cpp"
license=('MIT')
makedepends=('cmake' 'git' 'binutils' 'patchelf')
depends=('gcc-libs' 'glibc' 'openssl')
# The three per-CPU packages of 10398-1; libalpm swaps them for this one at
# the next -Syu (it looks for replacers before the package itself).
replaces=('ai2-llama-cpp-baseline' 'ai2-llama-cpp-noavx' 'ai2-llama-cpp-avx2')
conflicts=('ai2-llama-cpp-baseline' 'ai2-llama-cpp-noavx' 'ai2-llama-cpp-avx2')
# For an optional backend package built from the same tree (a GPU backend
# module must match this exact ggml).
provides=("ai2-llama-cpp-runtime=$pkgver-$pkgrel")
options=('!lto' '!debug')
source=("llama.cpp::git+https://github.com/ggml-org/llama.cpp.git#tag=$_tag"
        'isa-check.sh')
sha256sums=('SKIP' 'SKIP')

_rtdir=/usr/lib/ai2/runtimes/llama.cpp

build() {
  # The contract for everything that is not a CPU variant: plain x86-64 plus
  # popcnt (the 10398-1 baseline had it too; every 2008+ CPU has it and the
  # gate allows it). ggml adds each variant's -m flags PRIVATE to that
  # variant's target, on top of these; GGML_NATIVE=OFF is required by
  # GGML_BACKEND_DL and is what keeps the container's CPU out of the build.
  local flags='-march=x86-64 -mtune=generic -mpopcnt'
  cmake -S llama.cpp -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_BACKEND_DIR="$_rtdir" \
    -DGGML_NATIVE=OFF \
    -DGGML_OPENMP=ON \
    -DGGML_BLAS=OFF \
    -DGGML_VULKAN=OFF \
    -DGGML_CUDA=OFF \
    -DLLAMA_CURL=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_TOOLS=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_C_FLAGS="$CFLAGS $flags" -DCMAKE_CXX_FLAGS="$CXXFLAGS $flags"
  cmake --build build -j"$(nproc)"
}

# The files that ship, all from build/bin. Executables and their -impl libs,
# the core libraries, and every CPU variant module.
_shipped() {
  local t
  for t in llama-bench llama-cli llama-server; do
    echo "$t" "lib$t-impl.so"
  done
  ls build/bin/libggml.so* build/bin/libggml-base.so* build/bin/libllama.so* \
     build/bin/libllama-common.so* build/bin/libmtmd.so* 2>/dev/null | xargs -n1 basename
  ls build/bin/libggml-cpu-*.so | xargs -n1 basename
}

check() {
  local f files
  files=$(_shipped | tr ' ' '\n')     # from $srcdir, before the cd
  cd build/bin
  # Gate 1, per file. Everything that is not a CPU variant, plus the x64
  # variant, must run on the pure-SSE2 machine; the sse42 variant on the
  # no-AVX machine; the AVX-class variants are exempt by name (the runtime
  # score guards them, see the header).
  for f in $files; do
    case "$f" in
      libggml-cpu-x64.so) bash ../../isa-check.sh baseline "$f" ;;
      libggml-cpu-sse42.so) bash ../../isa-check.sh noavx "$f" ;;
      libggml-cpu-*.so) echo "isa-check skip [avx-class variant, runtime-scored] $f" ;;
      *) bash ../../isa-check.sh baseline "$f" ;;
    esac
  done
  # Gate 2: what a variant runs at dlopen must be clean for the pure-SSE2
  # machine, because the loader opens every variant before it can score it.
  for f in libggml-cpu-*.so; do
    bash ../../isa-check.sh ctors "$f"
  done
  # Every variant must be present, x64 first of all (the fallback that always scores).
  test -f libggml-cpu-x64.so
  test -f libggml-cpu-sse42.so
  test -f libggml-cpu-haswell.so
}

package() {
  local dest="$pkgdir$_rtdir" f files
  files=$(_shipped | tr ' ' '\n')
  install -d "$dest"
  for f in $files; do
    if [ -L "build/bin/$f" ]; then
      cp -a "build/bin/$f" "$dest/"
    else
      install -m755 "build/bin/$f" "$dest/"
    fi
  done
  # Flat layout: every ELF resolves siblings via $ORIGIN and nothing else
  # (cmake's own handling produced "$ORIGIN:", a trailing empty entry = cwd,
  # insecure, hence patchelf).
  for f in "$dest"/*; do
    [ -L "$f" ] && continue
    patchelf --set-rpath '$ORIGIN' "$f"
  done
  install -Dm644 llama.cpp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
